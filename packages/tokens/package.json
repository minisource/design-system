{
    "name": "@minisource/tokens",
    "version": "0.1.1",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./css": "./src/tokens.css",
        "./css.min": "./dist/tokens.min.css"
    },
    "files": [
        "dist",
        "src/tokens.css"
    ],
    "scripts": {
        "build": "tsup && node build.js",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf dist",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "tsup": "^8.3.5",
        "typescript": "^5.7.2"
    }
}